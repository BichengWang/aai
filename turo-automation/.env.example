# Turo Automation — Environment Variables
#
# Copy this file to .env (gitignored) and fill in your values.
# The app falls back to fixture data when Supabase variables are absent.

# ---------------------------------------------------------------------------
# Supabase — required for real persistence
# ---------------------------------------------------------------------------
# Worker reads these at runtime (Node process.env):
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<service-role-or-anon-key>

# Web reads these at Vite build time (must be prefixed VITE_):
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_KEY=<anon-key>
# Operator identity used by web approval and incident mutations.
VITE_OPERATOR_IDENTITY=ops.lead

# ---------------------------------------------------------------------------
# Slack — optional; enables real notifications
# ---------------------------------------------------------------------------
# Incoming webhook URL from a Slack app installation.
# When absent, the notifier is a no-op and jobs run silently.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/<T>/<B>/<token>

# ---------------------------------------------------------------------------
# Trip import — optional; enables real trip ingestion
# ---------------------------------------------------------------------------
# Absolute or relative path to a CSV file exported from Turo (or compatible).
# When absent, the import job runs but reads zero rows.
# Expected columns: external_trip_id, guest_full_name, guest_email,
#   guest_phone, vehicle_nickname, pickup_at, return_at, pickup_location,
#   return_location, trip_status, delivery_required, trip_total_amount, source
TRIP_IMPORT_CSV_PATH=/path/to/trips.csv

# ---------------------------------------------------------------------------
# Worker scheduler — optional; controls scheduled mode behavior
# ---------------------------------------------------------------------------
# Set WORKER_MODE=scheduled to keep the process alive and run jobs on intervals.
# Default (unset or "run-once") executes all jobs once then exits.
WORKER_MODE=scheduled
# Explicit safety gate for transitioning approved message drafts to sent.
WORKER_SEND_APPROVED_DRAFTS=false

# Job interval overrides in milliseconds (defaults shown):
INTERVAL_IMPORT_MS=300000       # 5 minutes
INTERVAL_LIFECYCLE_MS=900000    # 15 minutes
INTERVAL_LATE_RETURN_MS=900000  # 15 minutes
INTERVAL_DAILY_DIGEST_MS=3600000 # 1 hour

# Health check server — only active when WORKER_MODE=scheduled.
# Responds to GET /healthz with 200 {"status":"ok"} for orchestrator liveness probes.
HEALTHZ_PORT=3001

# ---------------------------------------------------------------------------
# Browser agent — optional; enables local Playwright-based Turo web automation
# ---------------------------------------------------------------------------
# Leave headless false for first-login/bootstrap flows.
TURO_BASE_URL=https://turo.com
BROWSER_AGENT_HEADLESS=false
BROWSER_AGENT_TIMEOUT_MS=15000
BROWSER_AGENT_SLOWMO_MS=0
BROWSER_AGENT_STORAGE_STATE_PATH=browser-agent/storage/state.json
BROWSER_AGENT_ARTIFACTS_DIR=browser-agent/artifacts
