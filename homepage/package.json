{
  "name": "altair-homepage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-netlify-auth-env.mjs && vite build && cp dist/index.html dist/404.html && node scripts/verify-built-routes.mjs",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:server": "node --test server/enquiry.test.mjs",
    "test": "npm run test:unit && npm run test:server"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.1",
    "docx-preview": "^0.3.7",
    "jszip": "^3.10.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.1",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.3.1",
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.0.2",
    "jsdom": "26.1.0",
    "typescript": "5.8.3",
    "vite": "7.3.6",
    "vitest": "5.0.2"
  }
}
